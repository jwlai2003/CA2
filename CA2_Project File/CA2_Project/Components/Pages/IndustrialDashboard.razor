@page "/industrial-dashboard"
@rendermode InteractiveServer

@using System
@using CA2_Project.Services

@inject MqttDashboardService Mqtt

<PageTitle>CA2 Industrial IIoT Dashboard</PageTitle>

<div class="industrial-page">
    <!-- HEADER -->
    <div class="industrial-header">
        <h2 class="fw-bold">
            Industrial IIoT Monitoring Dashboard
        </h2>
        <p class="mb-3">
            Smart Conveyor Weight Monitoring
            and Overload Detection System
        </p>
        <span class="badge bg-light text-dark me-2">
            WAGO 751-9301
        </span>
        <span class="badge bg-light text-dark me-2">
            Beaver IoT MQTT
        </span>
        <span class="badge bg-light text-dark">
            C# Blazor
        </span>
    </div>
    <!-- MONITORING DATA SOURCE -->
    <div class="industrial-card mb-3">
        <h5>Monitoring Data Source</h5>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn @(UseMqttMode
                                    ? "btn-outline-primary"
                                    : "btn-primary")"
                    @onclick="EnableSimulationMode">
                Simulation Mode
            </button>
            <button class="btn @(UseMqttMode
                                    ? "btn-primary"
                                    : "btn-outline-primary")"
                    @onclick="EnableMqttMode">
                WAGO MQTT Monitoring
            </button>
        </div>
        <div class="industrial-info mt-3">
            @if (UseMqttMode)
            {
                <strong>WAGO Live Monitoring</strong>
                <div class="mt-2">
                    Weight is calculated from the
                    Voltage value received through MQTT.
                </div>
                <div class="mt-1">
                    Conversion:
                    <strong>Weight = Voltage / 10</strong>
                </div>
                <div class="mt-1">
                    The Weight Slider is disabled
                    in this mode.
                </div>
            }
            else
            {
                <strong>Software Simulation</strong>
                <div class="mt-2">
                    Weight, NP9 and PNP can be
                    simulated directly from the Dashboard.
                </div>
            }
        </div>
    </div>
    <!-- SYSTEM OVERVIEW -->
    <div class="industrial-section">
        System Overview
    </div>
    <div class="industrial-grid">
        <!-- RUN STATUS -->
        <div class="industrial-card">
            <div class="industrial-label">
                System Status
            </div>
            @if (!DataAvailable)
            {
                <div class="industrial-value industrial-muted">
                    NO DATA
                </div>
            }
            else if (DisplayRun)
            {
                <div class="industrial-value industrial-good">
                    RUNNING
                </div>
            }
            else
            {
                <div class="industrial-value industrial-danger">
                    STOPPED
                </div>
            }
            <div class="industrial-label mt-2">
                PLC Internal RunEnable State
            </div>
        </div>
        <!-- PNP SENSOR -->
        <div class="industrial-card">
            <div class="industrial-label">
                PNP Proximity Sensor
            </div>
            @if (!DataAvailable)
            {
                <div class="industrial-value industrial-muted">
                    NO DATA
                </div>
            }
            else if (DisplayPnp)
            {
                <div class="industrial-value industrial-good">
                    DETECTED
                </div>
            }
            else
            {
                <div class="industrial-value industrial-muted">
                    NOT DETECTED
                </div>
            }
            <div class="industrial-label mt-2">
                Physical DI2 / Simulation
            </div>
        </div>
        <!-- WEIGHT STATUS -->
        <div class="industrial-card">
            <div class="industrial-label">
                Simulated Product Weight
            </div>
            @if (HasWeightData)
            {
                <div class="industrial-value
                    @(IsOverweight
                      ? "industrial-danger"
                      : "industrial-good")">
                    @DisplayWeightKg.ToString("F2") kg
                </div>
                <div class="mt-2">
                    @if (IsOverweight)
                    {
                        <span class="badge bg-danger">
                            OVERWEIGHT
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            NORMAL
                        </span>
                    }
                </div>
            }
            else
            {
                <div class="industrial-value industrial-muted">
                    NO DATA
                </div>
            }
            <div class="industrial-label mt-2">
                @(UseMqttMode
                  ? "Converted from WAGO Voltage"
                  : "Software Simulated Weight")
            </div>
        </div>
        <!-- DEVICE HEALTH -->
        <div class="industrial-card">
            <div class="industrial-label">
                Device Health
            </div>
            @if (!UseMqttMode)
            {
                <div class="industrial-value industrial-good">
                    SIMULATION
                </div>
            }
            else if (HasLiveData)
            {
                <div class="industrial-value industrial-good">
                    DATA FRESH
                </div>
            }
            else
            {
                <div class="industrial-value industrial-danger">
                    NO DATA
                </div>
            }
            <div class="industrial-label mt-2">
                MQTT Telemetry Freshness
            </div>
        </div>
    </div>
    <!-- WEIGHT MONITORING -->
    <div class="industrial-section">
        Weight Monitoring and Overload Detection
    </div>
    <div class="industrial-grid-two">
        <!-- WEIGHT MEASUREMENT -->
        <div class="industrial-card">
            <h5>Weight Measurement</h5>
            <div class="industrial-reading mb-4">
                <div class="industrial-label">
                    Current Simulated Weight
                </div>
                @if (HasWeightData)
                {
                    <div class="industrial-reading-number
                        @(IsOverweight
                          ? "industrial-danger"
                          : "industrial-good")">
                        @DisplayWeightKg.ToString("F2") kg
                    </div>
                    @if (IsOverweight)
                    {
                        <span class="badge bg-danger">
                            OVERWEIGHT
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            NORMAL
                        </span>
                    }
                }
                else
                {
                    <div class="industrial-reading-number
                        industrial-muted">
                        NO DATA
                    </div>
                    <span class="badge bg-secondary">
                        WAITING FOR WAGO
                    </span>
                }
            </div>
            <!-- LIVE WAGO SOURCE -->
            @if (UseMqttMode)
            {
                <div class="industrial-info mb-3">
                    <strong>WAGO Live Weight Source</strong>
                    <div class="mt-2">
                        PLC Voltage:
                        <strong>
                            @(HasWeightData
                              ? $"{Mqtt.Voltage:F2}"
                              : "NO DATA")
                        </strong>
                    </div>
                    <div class="mt-2">
                        Simulated Weight:
                        <strong>
                            @(HasWeightData
                              ? $"{LiveWeightKg:F2} kg"
                              : "NO DATA")
                        </strong>
                    </div>
                    <div class="mt-2">
                        Formula:
                        <strong>
                            Weight (kg) = Voltage / 10
                        </strong>
                    </div>
                    <div class="mt-2">
                        Adjust the physical input device
                        to change the reported value.
                    </div>
                </div>
            }
            <!-- SOFTWARE WEIGHT INPUT -->
            <label class="form-label fw-bold">
                Weight Input
            </label>
            <div class="d-flex justify-content-between mb-2">
                <span class="industrial-label">
                    @(UseMqttMode
                      ? "WAGO-controlled value"
                      : "Manual simulated weight")
                </span>
                <strong>
                    @(HasWeightData
                      ? $"{DisplayWeightKg:F2} kg"
                      : "NO DATA")
                </strong>
            </div>
@if (UseMqttMode)
{
    <input type="range"
           class="form-range"
           min="0"
           max="@Math.Max(10.0, Math.Ceiling(DisplayWeightKg))"
           step="0.1"
           value="@DisplayWeightKg.ToString(
               System.Globalization.CultureInfo.InvariantCulture)"
           disabled />
}
else
{
    <input type="range"
           class="form-range"
           min="0"
           max="10"
           step="0.1"
           @bind="WeightKg"
           @bind:event="oninput"
           @bind:after="EvaluateWeight" />
}
            <div class="d-flex justify-content-between
                industrial-label mb-3">
                <span>0 kg</span>
                <span>10 kg</span>
            </div>
            <button class="btn btn-outline-secondary btn-sm"
                    disabled="@UseMqttMode"
                    @onclick="ResetWeight">
                Reset Weight
            </button>
            <p class="industrial-label mt-3 mb-0">
                This is a simulated engineering weight.
                No calibrated physical load cell is connected.
            </p>
        </div>
        <!-- WEIGHT THRESHOLD -->
        <div class="industrial-card">
            <h5>Overweight Threshold Configuration</h5>
            <label class="form-label fw-bold">
                Maximum Allowed Weight
            </label>
            <div class="d-flex justify-content-between mb-2">
                <span class="industrial-label">
                    Configurable Weight Limit
                </span>
                <strong>
                    @WeightThresholdKg.ToString("F2") kg
                </strong>
            </div>
            <input type="range"
                   class="form-range"
                   min="0.5"
                   max="10"
                   step="0.5"
                   @bind="WeightThresholdKg"
                   @bind:event="oninput"
                   @bind:after="EvaluateWeight" />
            <hr />
            @if (!HasWeightData)
            {
                <div class="alert alert-warning">
                    <strong>WEIGHT DATA UNAVAILABLE</strong>
                    <p class="mt-2 mb-0">
                        Fresh WAGO Voltage data is not
                        available.
                        Weight alarm evaluation
                        is suspended.
                    </p>
                </div>
            }
            else if (IsOverweight)
            {
                <div class="alert alert-danger">
                    <strong>OVERWEIGHT ALERT</strong>
                    <p class="mt-2">
                        Simulated product weight
                        exceeds the configured limit.
                    </p>
                    <div>
                        Current Weight:
                        <strong>
                            @DisplayWeightKg.ToString("F2") kg
                        </strong>
                    </div>
                    <div>
                        Maximum Weight:
                        <strong>
                            @WeightThresholdKg.ToString("F2") kg
                        </strong>
                    </div>
                    <div>
                        Excess Weight:
                        <strong>
                            @ExcessWeightKg.ToString("F2") kg
                        </strong>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-success">
                    <strong>WEIGHT NORMAL</strong>
                    <p class="mt-2 mb-0">
                        Simulated weight is within
                        the configured limit.
                    </p>
                </div>
            }
            <div class="industrial-label">
                Overweight and recovery events
                are recorded in Event History.
            </div>
        </div>
    </div>
    <!-- MQTT COMMUNICATION -->
    <div class="industrial-section">
        MQTT Communication
    </div>
    <div class="industrial-grid-two">
        <!-- MQTT BROKER -->
        <div class="industrial-card">
            <h5>Beaver IoT Broker</h5>
            <div class="mb-3">
                <strong>Broker Status:</strong>
                @if (Mqtt.IsConnected)
                {
                    <span class="badge bg-success">
                        CONNECTED
                    </span>
                }
                else
                {
                    <span class="badge bg-danger">
                        DISCONNECTED
                    </span>
                }
            </div>
            <div class="mb-2">
                <strong>Broker:</strong>
                192.168.101.59:1883
            </div>
            <div class="mb-2">
                <strong>Device ID:</strong>
                @Mqtt.DeviceId
            </div>
            <div class="mb-2">
                <strong>Device Name:</strong>
                @Mqtt.DeviceName
            </div>
            <hr />
            <h6 class="fw-bold">
                Received WAGO MQTT Sensor Data
            </h6>
            <div class="mb-2">
                <strong>PNP Sensor:</strong>
                @(HasLiveData
                  ? (Mqtt.SensorDetected
                      ? "DETECTED"
                      : "NOT DETECTED")
                  : "NO DATA")
            </div>
            <div class="mb-2">
                <strong>Voltage:</strong>
                @(HasLiveData && Mqtt.HasVoltage
                  ? $"{Mqtt.Voltage:F2}"
                  : "NO DATA")
            </div>
            <div class="mb-2">
                <strong>Simulated Weight:</strong>
                @(HasLiveWeightData
                  ? $"{LiveWeightKg:F2} kg"
                  : "NO DATA")
            </div>
            <div class="mb-2">
                <strong>Run Enable:</strong>
                @(HasLiveData
                  ? Mqtt.RunEnable.ToString()
                  : "NO DATA")
            </div>
            <div class="mb-2">
                <strong>Device Status:</strong>
                @Mqtt.DeviceStatus
            </div>
            <div class="mb-2">
                <strong>Data Freshness:</strong>
                @(HasLiveData
                  ? "FRESH"
                  : "STALE / UNAVAILABLE")
            </div>
            <div class="mb-3">
                <strong>Last Update:</strong>
                @(Mqtt.LastUpdated?.ToString(
                    "yyyy-MM-dd HH:mm:ss") ?? "NO DATA")
            </div>
            <button class="btn btn-primary"
                    disabled="@Mqtt.IsConnected"
                    @onclick="ConnectMqttAsync">
                Connect MQTT
            </button>
            @if (!string.IsNullOrWhiteSpace(Mqtt.LastError))
            {
                <div class="alert alert-warning mt-3 mb-0">
                    MQTT Error: @Mqtt.LastError
                </div>
            }
        </div>
        <!-- REMOTE START / STOP -->
        <div class="industrial-card">
            <h5>Remote START / STOP Control</h5>
            <p class="industrial-label">
                Dashboard commands are published
                through Beaver IoT MQTT to the
                WAGO PLC.
            </p>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button class="btn btn-success"
                        disabled="@(!Mqtt.IsConnected || Mqtt.IsCommandPending)"
                        @onclick='() => SendCommandAsync("START")'>
                    Publish START
                </button>
                <button class="btn btn-danger"
                        disabled="@(!Mqtt.IsConnected || Mqtt.IsCommandPending)"
                        @onclick='() => SendCommandAsync("STOP")'>
                    Publish STOP
                </button>
            </div>
            <div class="mb-2">
                <strong>Last Command:</strong>
                @Mqtt.LastCommand
            </div>
            <div class="mb-2">
                <strong>Command State:</strong>
                @Mqtt.CommandState
            </div>
            <div class="mb-2">
                <strong>Command Detail:</strong>
                @Mqtt.CommandDetail
            </div>
            <div class="mb-2">
                <strong>Command ID:</strong>
                <span class="industrial-label">
                    @Mqtt.LastCommandId
                </span>
            </div>
            <div class="industrial-info mt-3">
                Remote START / STOP changes only
                the internal PLC RunEnable test state.
                It does not operate a physical motor.
                A matching acknowledgement is
                needed to confirm command execution.
            </div>
        </div>
    </div>
    <!-- RAW MQTT PAYLOAD -->
    <div class="industrial-card mt-3">
        <h5>Last MQTT Telemetry Message</h5>
        <div class="industrial-message">
            @Mqtt.LastMessage
        </div>
        <div class="industrial-label mt-3">
            Topic:
            @MqttDashboardService.TelemetryTopic
        </div>
        <div class="industrial-card mt-3">
            <h5>MQTT Telemetry Diagnostics</h5>
            <div class="mb-2">
                <strong>Telemetry Messages Received:</strong>
                @Mqtt.TelemetryReceivedCount
            </div>
            <div class="mb-2">
                <strong>Telemetry Parse Errors:</strong>
                @Mqtt.TelemetryErrorCount
            </div>
            <div class="mb-2">
                <strong>Last Message Received:</strong>
                @(Mqtt.LastMessageReceivedAt?.ToString(
                    "HH:mm:ss") ?? "NO DATA")
            </div>
            <div class="mb-2">
                <strong>Last Valid Telemetry:</strong>
                @(Mqtt.LastUpdated?.ToString(
                    "HH:mm:ss") ?? "NO DATA")
            </div>
            <div class="mb-2">
                <strong>Parsed Voltage:</strong>
                @(Mqtt.HasVoltage
                  ? $"{Mqtt.Voltage:F2}"
                  : "NO DATA")
            </div>
            @if (!string.IsNullOrWhiteSpace(
                Mqtt.LastTelemetryError))
            {
                <div class="alert alert-danger mt-3">
                    <strong>Telemetry Parse Error:</strong>
                    @Mqtt.LastTelemetryError
                </div>
            }
        </div>
    </div>
    <!-- PHYSICAL HARDWARE EVENTS -->
    <div class="industrial-section">
        Physical Hardware Event Monitoring
    </div>
    <div class="industrial-card">
        @if (HasLiveData && Mqtt.HasPhysicalEventCounters)
        {
            <div class="industrial-grid">
                <div>
                    <div class="industrial-label">
                        NP9 Button Presses
                    </div>
                    <div class="industrial-value">
                        @Mqtt.NP9PressCount
                    </div>
                </div>
                <div>
                    <div class="industrial-label">
                        PNP Object Detected
                    </div>
                    <div class="industrial-value">
                        @Mqtt.PNPDetectCount
                    </div>
                </div>
                <div>
                    <div class="industrial-label">
                        PNP Object Removed
                    </div>
                    <div class="industrial-value">
                        @Mqtt.PNPRemoveCount
                    </div>
                </div>
                <div>
                    <div class="industrial-label">
                        Telemetry Interval
                    </div>
                    <div class="industrial-value">
                        ~5 s
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning mb-0">
                Physical event counters are unavailable
                or telemetry is not fresh.
                Confirm that the WAGO PLC publishes
                np9_press_count, pnp_detect_count,
                and pnp_remove_count.
            </div>
        }
    </div>
    <!-- SIMULATION CONTROLS -->
    <div class="industrial-section">
        Local Input Simulation
    </div>
    <div class="industrial-grid-two">
        <!-- NP9 SIMULATION -->
        <div class="industrial-card">
            <h5>NP9 Push Button Simulation</h5>
            <div class="mb-3">
                Current State:
                <strong>
                    @(SimulationRun
                      ? "RUNNING"
                      : "STOPPED")
                </strong>
            </div>
            <button class="btn btn-primary"
                    disabled="@UseMqttMode"
                    @onclick="SimulateNp9">
                Press NP9 Button
            </button>
            <p class="industrial-label mt-3 mb-0">
                Software simulation only.
                Does not change the physical PLC input.
            </p>
        </div>
        <!-- PNP SIMULATION -->
        <div class="industrial-card">
            <h5>PNP Sensor Simulation</h5>
            <div class="mb-3">
                Sensor State:
                <strong>
                    @(SimulationPnp
                      ? "DETECTED"
                      : "NOT DETECTED")
                </strong>
            </div>
            <button class="btn btn-outline-primary"
                    disabled="@UseMqttMode"
                    @onclick="ToggleSimulatedPnp">
                Toggle PNP Sensor
            </button>
            <p class="industrial-label mt-3 mb-0">
                Simulates product detection
                without changing WAGO DI2.
            </p>
        </div>
    </div>
    <!-- FAULT DETECTION AND HEARTBEAT -->
    <div class="industrial-section">
        Fault Detection and Heartbeat
    </div>
    <div class="industrial-grid-two">
        <!-- HEARTBEAT -->
        <div class="industrial-card">
            <h5>Simulation Heartbeat Monitoring</h5>
            <div class="mb-3">
                <strong>Status:</strong>
                @if (SimulationHeartbeatFault)
                {
                    <span class="badge bg-danger">
                        HEARTBEAT TIMEOUT
                    </span>
                }
                else
                {
                    <span class="badge bg-success">
                        HEARTBEAT ACTIVE
                    </span>
                }
            </div>
            <p class="industrial-label">
                Simulated heartbeat interval:
                2 seconds.
                Timeout threshold:
                6 seconds.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-warning"
                        disabled="@HeartbeatPaused"
                        @onclick="PauseHeartbeat">
                    Pause Heartbeat
                </button>
                <button class="btn btn-success"
                        disabled="@(!HeartbeatPaused)"
                        @onclick="ResumeHeartbeat">
                    Resume Heartbeat
                </button>
            </div>
        </div>
        <!-- NETWORK FAULT -->
        <div class="industrial-card">
            <h5>Network Fault Simulation</h5>
            <div class="mb-3">
                <strong>Status:</strong>
                @if (SimulatedNetworkLoss)
                {
                    <span class="badge bg-danger">
                        NETWORK FAULT
                    </span>
                }
                else
                {
                    <span class="badge bg-success">
                        NORMAL
                    </span>
                }
            </div>
            <p class="industrial-label">
                Software-only fault demonstration.
                Actual MQTT communication is not disconnected.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-danger"
                        disabled="@SimulatedNetworkLoss"
                        @onclick="SimulateNetworkLoss">
                    Simulate Network Loss
                </button>
                <button class="btn btn-success"
                        disabled="@(!SimulatedNetworkLoss)"
                        @onclick="RestoreNetwork">
                    Restore Network
                </button>
            </div>
        </div>
    </div>
    <!-- EVENT HISTORY -->
    <div class="industrial-section">
        Event History and Alarm Log
    </div>
    <div class="industrial-card">
        <div class="d-flex justify-content-between
            align-items-center mb-3">
            <h5 class="mb-0">
                System Event History
            </h5>
            <button class="btn btn-outline-secondary btn-sm"
                    @onclick="ClearHistory">
                Clear History
            </button>
        </div>
        <div class="industrial-log">
            @if (Events.Count == 0)
            {
                <p class="industrial-label mb-0">
                    No events recorded.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Category</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Events)
                            {
                                <tr>
                                    <td style="white-space:nowrap">
                                        @entry.Time.ToString("HH:mm:ss")
                                    </td>
                                    <td>
                                        <strong>
                                            @entry.Category
                                        </strong>
                                    </td>
                                    <td>
                                        @entry.Message
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    
<!-- LIVE CONVEYOR VISUALIZATION -->
<div class="industrial-section">
    Live Conveyor Visualization
</div>

<ConveyorVisualization
    IsRunning="@(DataAvailable && DisplayRun)"
    IsDetected="@(DataAvailable && DisplayPnp)"
    WeightKg="@DisplayWeightKg"
    WeightLimitKg="@WeightThresholdKg"
    HasData="@(DataAvailable && (!UseMqttMode || HasWeightData))"
    IsMqttMode="@UseMqttMode" />

    <!-- FOOTER -->
    <div class="text-center industrial-label mt-4">
        TMS202/04 - Industrial IIoT Application
        <div>
            WAGO PLC | Beaver IoT | C# .NET Blazor
        </div>
        <div>
            Weight is derived from an adjustable
            input signal for educational simulation.
            No physical load cell is used.
        </div>
    </div>
</div>
